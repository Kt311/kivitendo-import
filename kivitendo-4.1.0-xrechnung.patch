+
+    $::form->error(
+      "Position $i: Der Steuersatz aus der XML (" . ($wanted_rate * 100)
+      . " %) ist fuer das Artikelkonto nicht eingerichtet."
+    ) unless $tax;
+
+    $::form->{"tax_chart_type_$i"} = $tax_chart_type;
+    $::form->{"tax_id_$i"}         = $tax->id;
+  }
+
+  display_form();
 
   $main::lxdebug->leave_sub();
 }
