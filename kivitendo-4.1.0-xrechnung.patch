+  for my $i (1 .. ($::form->{rowcount} || 0)) {
+    my $message = delete $::form->{"_zugferd_mapping_info_$i"};
+    push @mapping_messages, $message if $message;
+  }
+  flash(
+    'warning',
+    'Artikelzuordnung aus der XRechnung vor dem Buchen kontrollieren:',
+    @mapping_messages,
+  ) if @mapping_messages;
+
+  $::form->{show_details} = $::myconfig{show_form_details};
+  $::form->{title}        = $::locale->text('Record Vendor Invoice');
+  $::form->{form_validity_token} ||= SL::DB::ValidityToken->create(
+    scope => SL::DB::ValidityToken::SCOPE_PURCHASE_INVOICE_POST()
+  )->token;
+
+  prepare_invoice();
+  relink_accounts();
+
+  for my $i (1 .. $::form->{rowcount}) {
+    my $wanted_rate = delete $::form->{"_zugferd_tax_rate_$i"};
+    next unless defined $wanted_rate;
+
+    my $tax_chart_type = ($::form->{"part_type_$i"} eq 'part')
+                      && ($::instance_conf->get_inventory_system eq 'perpetual')
+                       ? 'inventory'
+                       : 'expense';
+    my $chart_id = $::form->{"${tax_chart_type}_accno_id_$i"};
+
+    $::form->error("Position $i: Fuer den zugeordneten Artikel ist kein passendes Buchungskonto vorhanden.")
+      unless $chart_id;
+
+    my @taxes = IO->get_active_taxes_for_chart($chart_id, $::form->{invdate});
