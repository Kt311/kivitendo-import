+    "The ZUGFeRD/Factur-X invoice '#1' has been loaded.", $file_name
+  )) if $file_name;
+
+  # invoice_links needs the vendor first. It loads account, tax-zone and vendor
+  # defaults; afterwards the values originating from the XML are restored.
+  $::form->{vendor_id} = $form_defaults->{vendor_id};
